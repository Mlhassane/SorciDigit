# Neon Postgres (CMS : projets, témoignages, galerie, activités)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin — mot de passe du dashboard /admin (serveur uniquement, jamais de préfixe NEXT_PUBLIC_)
ADMIN_PASSWORD=choisissez-un-mot-de-passe-fort

# Optionnel : secret dédié à la signature du cookie de session (défaut : ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET=autre-secret-long-et-aleatoire

# Vercel Blob — créer un store "Blob" dans le dashboard Vercel, puis récupérer le token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
